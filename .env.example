# Application
APP_NAME="LSR app"
# true enables debug mode (Tracy, template auto refresh, route timestamp checks); never in production.
APP_DEBUG=false
# Optional: absolute path, or relative to the application root. Defaults to ./upload
UPLOAD_DIR=

# Database connection; set private credentials in the deployment environment.
DB_HOST=db
DB_PORT=3306
DB_NAME=app
DB_USER=
DB_PASSWORD=
DB_COLLATE=utf8mb4
DB_LAZY=true
DB_DRIVER=pdo

# RoadRunner log level (debug, info, warn, error)
RR_LOG_LEVEL=info
