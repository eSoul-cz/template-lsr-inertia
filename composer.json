{
    "name": "esoul-cz/template-lsr-inertia",
    "description": "eSoul Lsr (RoadRunner) application with an Inertia and Vue frontend.",
    "type": "project",
    "license": "MIT",
    "scripts": {
        "test": [
            "@putenv XDEBUG_MODE=off",
            "@php vendor/bin/phpunit"
        ],
        "test:parallel": [
            "@putenv XDEBUG_MODE=off",
            "@php vendor/bin/paratest"
        ],
        "test:coverage": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv XDEBUG_MODE=coverage",
            "@php -d memory_limit=2G vendor/bin/phpunit --coverage-text --only-summary-for-coverage-text"
        ],
        "phpstan": "./vendor/bin/phpstan --memory-limit=1G analyse",
        "phpstan:ci": [
            "Composer\\Config::disableProcessTimeout",
            "./vendor/bin/phpstan --memory-limit=1G analyse --no-progress"
        ],
        "cs": "./vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --diff",
        "cs:fix": "./vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php",
        "mutation": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv XDEBUG_MODE=coverage",
            "@php -d memory_limit=2G vendor/bin/infection --only-covering-test-cases --git-diff-lines --git-diff-base=main --ignore-msi-with-no-mutations --show-mutations @additional_args"
        ],
        "mutation:full": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv XDEBUG_MODE=coverage",
            "@php -d memory_limit=2G vendor/bin/infection --only-covering-test-cases --show-mutations @additional_args"
        ],
        "post-update-cmd": [
            "esoul-guidelines sync"
        ],
        "post-create-project-cmd": [
            "@php -r \"is_dir('.esoul') || mkdir('.esoul', 0755, true); is_file('LICENSE') && rename('LICENSE', '.esoul/template-LICENSE');\"",
            "@composer config license proprietary"
        ]
    },
    "require": {
        "php": "^8.5",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-gettext": "*",
        "ext-igbinary": "*",
        "ext-mbstring": "*",
        "ext-redis": "*",
        "ext-simplexml": "*",
        "ext-sockets": "*",
        "ext-zip": "*",
        "ext-zlib": "*",
        "dibi/dibi": "^5",
        "latte/latte": "^3.1",
        "lsr/caching": "^0.3.6",
        "lsr/console": "^0.2.1",
        "lsr/core": "^0.7.0",
        "lsr/db": "^0.3.16",
        "lsr/helpers": "^0.3.3",
        "lsr/inertia": "^0.1.9",
        "lsr/interfaces": "^0.3.21",
        "lsr/logging": "^0.3.4",
        "lsr/orm": "^0.4.0",
        "lsr/request": "^0.3.11",
        "lsr/roadrunner": "^0.1.19",
        "lsr/routing": "^0.5.0",
        "lsr/scheduler": "^0.1.3",
        "nette/assets": "^1.0",
        "nette/http": "^3.3",
        "nette/neon": "^3.4",
        "phpdocumentor/reflection-docblock": "^6.0",
        "spiral/roadrunner": "^2025.1",
        "spiral/roadrunner-http": "^4.1",
        "spiral/roadrunner-jobs": "^4.6",
        "spiral/roadrunner-worker": "^3.6"
    },
    "require-dev": {
        "brianium/paratest": "^7.24",
        "esoul-cz/coding-standard": "^0.1",
        "infection/infection": "^0.35",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-dibi": "^2.0",
        "phpstan/phpstan-nette": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^13",
        "roave/security-advisories": "dev-latest",
        "symfony/var-dumper": "^8.0",
        "esoul-cz/guidelines": "^0.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        }
    }
}
